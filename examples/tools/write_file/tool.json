{
  "api_version": 2,
  "id": "write_file",
  "version": "1.0.0",
  "name": "write_file",
  "description": "Create a file or replace its whole content, creating parent directories. Example: {\"path\":\"notes/todo.md\",\"content\":\"# Todo\\n\"}. Relative paths use the session cwd. The result says how many bytes were written and whether the file was created or overwritten. To change part of an existing file use edit_file instead. Successful writes appear in the Files changed panel.",
  "display": {
    "title": "Write",
    "kind": "edit",
    "summary": "{path}",
    "result": "text"
  },
  "entry": "./index.mjs",
  "input_schema": {
    "type": "object",
    "properties": {
      "path": {
        "type": "string",
        "minLength": 1,
        "description": "File path, absolute or relative to the session cwd."
      },
      "content": {
        "type": "string",
        "description": "The complete new content of the file."
      }
    },
    "required": [
      "path",
      "content"
    ],
    "additionalProperties": false
  },
  "condition_sources": [
    "effects"
  ],
  "effects_schema": {
    "type": "object",
    "properties": {
      "files": {
        "type": "array",
        "maxItems": 128,
        "items": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "operation": {
              "type": "string",
              "enum": [
                "write",
                "delete",
                "rename_source",
                "rename_destination"
              ]
            }
          },
          "required": [
            "path",
            "operation"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "files"
    ],
    "additionalProperties": false
  },
  "panels": [
    {
      "id": "files_changed",
      "placement": "sidebar",
      "title": "Files changed",
      "icon": "folder-tree",
      "open": "first_update",
      "context": "none",
      "acp_plan": false,
      "actions": []
    }
  ]
}
