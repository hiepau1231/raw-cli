{
  "api_version": 2,
  "id": "ask_user",
  "version": "1.0.0",
  "name": "ask_user",
  "description": "Ask the user one question and wait for the answer. Example: {\"question\":\"Which database should the service use?\",\"options\":[\"Postgres\",\"SQLite\"]}. Without options the answer is free text; with options the user picks one (or several with multi_select) and, unless allow_other is false, may answer in their own words instead. The result is the answer as text, e.g. User answered: Postgres, or User skipped the question. To ask up to 3 related questions in one form, send questions: [{question, header, options, multiSelect}]. This gathers information and never grants tool permission. Hosts without an input adapter (non-TTY CLI, ACP without the extension) fail promptly.",
  "entry": "./index.mjs",
  "input_schema": {
    "type": "object",
    "properties": {
      "question": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "description": "The question, in plain words."
      },
      "header": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "description": "Optional short label shown above the question."
      },
      "options": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "description": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": [
                "label"
              ],
              "additionalProperties": false
            }
          ]
        },
        "description": "Choices as strings or {label, description}. Omit for a free-text answer."
      },
      "multi_select": {
        "type": "boolean",
        "default": false,
        "description": "Let the user pick several options."
      },
      "allow_other": {
        "type": "boolean",
        "default": true,
        "description": "With options: also let the user answer in their own words."
      },
      "questions": {
        "type": "array",
        "minItems": 1,
        "maxItems": 3,
        "description": "Several questions in one form, instead of question.",
        "items": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "description": "The question, in plain words."
            },
            "header": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Optional short label shown above the question."
            },
            "options": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "description": {
                        "type": "string",
                        "maxLength": 500
                      }
                    },
                    "required": [
                      "label"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "description": "Choices as strings or {label, description}. Omit for a free-text answer."
            },
            "multi_select": {
              "type": "boolean",
              "default": false,
              "description": "Let the user pick several options."
            },
            "allow_other": {
              "type": "boolean",
              "default": true,
              "description": "With options: also let the user answer in their own words."
            }
          },
          "required": [
            "question"
          ],
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "panels": [
    {
      "id": "questions",
      "title": "Questions",
      "icon": "file-text",
      "open": "never",
      "placement": "chat",
      "context": "none",
      "acp_plan": false,
      "actions": [
        {
          "id": "submit",
          "label": "Send answer",
          "scope": "block",
          "blocks": [
            "form"
          ],
          "kind": "response",
          "response": "submit"
        },
        {
          "id": "cancel",
          "label": "Cancel",
          "scope": "block",
          "blocks": [
            "form"
          ],
          "kind": "response",
          "response": "cancel"
        }
      ]
    }
  ]
}
